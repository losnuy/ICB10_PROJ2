# 파이썬 데이터 분석을 위한 .gitignore 설정

# --- 파이썬 컴파일 및 캐시 파일 ---
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ipynb_checkpoints/
.ruff_cache/
.mypy_cache/

# --- 가상환경 (Virtual Environments) ---
.venv/
venv/
env/
ENV/
bin/
lib/
develop-eggs/
downloads/
eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Jupyter Notebook 관련 ---
# 노트북 실행 결과 캐시 및 임시 파일
.ipynb_checkpoints
*/.ipynb_checkpoints/*
# Jupyter Lab 임시 설정
.jupyter/
# IPython 기록
.ipython/

# --- 데이터 및 대용량 파일 (Data & Heavy Files) ---
# 데이터 파일은 일반적으로 Git 저장소에 올리지 않고 별도 관리합니다.
data/
*.csv
*.xlsx
*.xls
*.tsv
*.jsonl
# Pickle 파일 (직렬화 데이터)
*.pkl
*.pickle
# 대용량 바이너리/열 형식 데이터
*.parquet
*.h5
*.hdf5
*.npy
*.npz
*.db
*.sqlite

# --- 환경 변수 및 설정 파일 (보안 정보 포함) ---
.env
.env.local
.env.*
secrets.json
credentials.json

# --- IDE 및 에디터 설정 ---
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/code-workspace

# PyCharm / IntelliJ
.idea/

# --- OS 임시 파일 ---
.DS_Store
Thumbs.db
Desktop.ini
